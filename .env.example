TELEGRAM_BOT_TOKEN=
BOT_OWNER_ID=
AI_MODELS=default

# codex = use your own Codex login (the supported portable setup).
# openclaw = optional bridge to an existing isolated agent.
# openai = call OpenAI API directly from this service.
ANSWER_BACKEND=codex

# Optional profile catalog for ANSWER_BACKEND=codex. Use its default or select a name.
# BOT_PROFILE_FILE=src/profiles.example.json
# BOT_PROFILE=neutral

# Required only when ANSWER_BACKEND=openai.
OPENAI_API_KEY=

# Optional. Defaults are usually fine.
OPENCLAW_CLI=openclaw
OPENCLAW_AGENT_ID=telegram-aibot
OPENCLAW_SESSION_VERSION=v6
OPENCLAW_SESSION_WINDOW_HOURS=24
OPENCLAW_THINKING=low
OPENCLAW_TIMEOUT_SECONDS=180
OPENAI_MODEL=gpt-4.1-mini
BOT_SYSTEM_PROMPT=You are a concise helpful AI assistant in a Telegram group. Answer only the question asked. Use web search when current facts are needed.
MAX_HISTORY_MESSAGES=8
CHAT_BUFFER_MAX_MESSAGES=500
CHAT_BUFFER_MAX_AGE_HOURS=24
HISTORY_SLICE_MAX_MESSAGES=300
TELEGRAM_POLL_TIMEOUT_SECONDS=45
TELEGRAM_API_MAX_RETRIES=3
TELEGRAM_API_RETRY_BASE_MS=1000
TELEGRAM_POLL_FAILURE_EXIT_THRESHOLD=3
BOT_LOCK_FILE=bot.pid

# Production-safe logs redact chat ids, user ids, and message text by default.
# Set true only for a short local debug window.
DEBUG_RAW_TELEGRAM_LOGS=false
LOG_TELEGRAM_CHAT_TITLES=false

# Dedicated Obsidian-style Markdown memory for this Telegram bot only.
MEMORY_ENABLED=true
MEMORY_DIR=memory
MEMORY_MAX_PROMPT_CHARS=2500
MEMORY_AUTO_CAPTURE=true
MEMORY_AUTO_SAVE_LOW_RISK=true
MEMORY_CONFIRM_MEDIUM_RISK=true
# off = no memory writes; commands_only = /remember and direct bot-triggered memory only.
# passive_private_only = passive extraction in private chats; passive_groups_enabled = also allow passive group extraction.
MEMORY_PRIVACY_MODE=commands_only
MEMORY_PASSIVE_CAPTURE=false
MEMORY_PASSIVE_GROUP_CAPTURE=false
MEMORY_PASSIVE_SAVE_LOW_RISK=true
MEMORY_PASSIVE_INBOX_MEDIUM_RISK=true
MEMORY_EXTRACTOR_MODEL=gpt-4.1-mini

# Moderation allowlist. Prefer stable Telegram numeric IDs; usernames are a fallback.
MODERATION_ALLOWED_USER_IDS=
MODERATION_ALLOWED_USERNAMES=

# Optional private JSON catalog keyed by Telegram group ID. See src/group-settings.example.json.
BOT_GROUP_SETTINGS_FILE=

# Built-in game definitions and legacy rosters.
# Defaults to src/assemble-games.json. Natural invitations use the independent Codex backend.
ASSEMBLE_GAMES_FILE=
# Defaults to assemble-state.json beside BOT_LOCK_FILE; preserves cooldowns and menus.
ASSEMBLE_STATE_FILE=
# Persistent per-chat member roster; a complete initial group inventory is needed for /assemble.
ASSEMBLE_MEMBERS_FILE=
# fortnite.gif, rocket-league.gif, arc-riders.gif; independent deployment uses /state/assets/games.
ASSEMBLE_GAME_ASSET_DIR=assets/games

# Reply with a GIF/MP4 animation only when a group message insults this bot by
# mention, reply, or configured alias. INSULT_REPLY_ANIMATION may be a Telegram
# file_id or HTTPS URL; otherwise the local media path is uploaded.
INSULT_REPLY_ENABLED=false
INSULT_REPLY_ANIMATION=
INSULT_REPLY_MEDIA_PATH=assets/insult-reply.mp4
INSULT_REPLY_ALIASES=бот,боте,bot
# Optional comma-separated additions to the built-in Ukrainian/English/Russian terms.
INSULT_REPLY_EXTRA_TERMS=

# Local voice/audio transcription.
VOICE_TRANSCRIPTION_ENABLED=true
VOICE_MAX_DURATION_SECONDS=180

# false = transcribe only private messages, replies to the bot, and caption/text mentions.
# true = also transcribe other group voice/audio so it can be stored in recent context.
VOICE_TRANSCRIBE_UNTRIGGERED=false

# true = answer every group voice/audio message after transcription.
VOICE_GROUP_AUTO_REPLY=false

WHISPER_PYTHON=python3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_TIMEOUT_SECONDS=180

# Optional TikTok fallback API used only when yt-dlp exposes audio/thumbnail but no video.
SOCIAL_VIDEO_TIKTOK_FALLBACK_API=https://www.tikwm.com/api/

# Social downloader hardening.
SOCIAL_VIDEO_MAX_DURATION_SECONDS=300
SOCIAL_VIDEO_HTTP_TIMEOUT_MS=45000
SOCIAL_VIDEO_CIRCUIT_FAILURE_THRESHOLD=3
SOCIAL_VIDEO_CIRCUIT_COOLDOWN_MS=600000

# Seven-day local conversation history (separate from long-term personal memory).
CHAT_TIME_ZONE=UTC
# CONVERSATION_HISTORY_DIR=/state/runtime/conversations
# BOT_INBOX_FILE=/state/runtime/update-inbox.json
# HTTPS address of the Flappy Bird Mini App (no bot token belongs in the game).
FLAPPY_BIRD_URL=
# Separate Duel service: public bot username used in invitation links.
# DUEL_BOT_USERNAME=YourGroupBot
# Occupiers: the same bot owns the durable group registry; never put its token in the game.
OCCUPIERS_URL=
OCCUPIERS_ROOMS_FILE=
# Separate game container: public Telegram bot ID, HTTPS origin and read-only registry.
# OCCUPIERS_BOT_ID=123456789
# OCCUPIERS_ORIGIN=https://games.example.com
# OCCUPIERS_ROOMS_FILE=/data/rooms.json
# Optional game settings: OCCUPIERS_DURATION_MS=300000, OCCUPIERS_MAX_PLAYERS=12,
# OCCUPIERS_PROTECTION_MS=3000, OCCUPIERS_SPAWN_RADIUS=62, OCCUPIERS_SPAWN_DISTANCE=200
