TELEGRAM_BOT_TOKEN=
BOT_OWNER_ID=
BOT_REQUIRE_OWNER=true
BOT_PROFILE=neutral
# Use the Codex CLI default, or list models available to your account.
AI_MODELS=default
MEMORY_PRIVACY_MODE=commands_only
MEMORY_AUTO_CAPTURE=false
VOICE_TRANSCRIPTION_ENABLED=true
# All received group voices are context; ordinary speech receives no reply.
VOICE_TRANSCRIBE_UNTRIGGERED=true
VOICE_GROUP_AUTO_REPLY=false
# No duration exclusion by default; file/processing limits still apply.
VOICE_MAX_DURATION_SECONDS=0
SOCIAL_VIDEO_ENABLED=true
VISUAL_SUMMARY_ENABLED=true

# Claude backend (optional; also needs deploy/compose.claude.yaml). API key from Claude Console.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_CLASSIFY_MODEL=claude-haiku-5-5
